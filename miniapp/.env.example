# ───────────────────────────────────────
# AiCustomerService Miniapp 环境配置模板
# ───────────────────────────────────────
# 环境文件说明:
#   .env                → 开发环境（默认加载）
#   .env.development     → 开发环境覆盖（npm run dev 时）
#   .env.production      → 生产环境（npm run build 时）
#
# 本地开发:
#   VITE_API_BASE=http://localhost:8001/api/v1
#   VITE_SERVER_BASE=http://localhost:8001
#
# 生产部署:
#   VITE_API_BASE=https://your-domain.com/api/v1
#   VITE_SERVER_BASE=https://your-domain.com
# ───────────────────────────────────────

# 后端 API 地址
VITE_API_BASE=http://localhost:8001/api/v1

# 后端完整地址（用于图片 URL 补全）
VITE_SERVER_BASE=http://localhost:8001
