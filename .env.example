# ───────────────────────────────────────
# AiCustomerService 环境配置模板
# ───────────────────────────────────────
# 复制为 .env 或 .env.production 并填入实际值
#
# 环境文件说明:
#   .env                → 开发环境（默认加载）
#   .env.development     → 开发环境覆盖
#   .env.production      → 生产环境
#
# Docker 使用:
#   docker compose --env-file ../.env.production up -d
# ───────────────────────────────────────

# ---- 应用 ----
APP_NAME=AiCustomerService
DEBUG=true
SECRET_KEY=change-me-in-production

# ---- LLM ----
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-your-api-key-here
OPENAI_BASE_URL=https://your-workspace-id.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
OPENAI_MODEL=qwen3.7-plus
FAST_LLM_MODEL=qwen-plus

# ---- Embedding ----
EMBEDDING_PROVIDER=dashscope
DASHSCOPE_API_KEY=sk-your-api-key-here
DASHSCOPE_BASE_URL=https://your-workspace-id.cn-beijing.maas.aliyuncs.com/api/v1
EMBEDDING_MODEL=text-embedding-v3

# ---- Qdrant ----
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=knowledge_base
QDRANT_VECTOR_SIZE=1024

# ---- 数据库 ----
DATABASE_URL=sqlite+aiosqlite:///./data/sqlite/app.db

# ---- RAG ----
CHUNK_SIZE=500
CHUNK_OVERLAP=50
TOP_K_RETRIEVAL=5
TOP_K_RERANK=3
RETRIEVAL_SCORE_THRESHOLD=0.5

# ---- 对话 ----
MAX_HISTORY_LENGTH=10
STREAMING=true
TEMPERATURE=0.3

# ---- 管理员 ----
ADMIN_API_KEY=admin-secret-key

# ---- 媒体文件 ----
MEDIA_DIR=./data/media/images
MEDIA_BASE_URL=/media/images

# ---- 外部充电桩 API ----
EXTERNAL_API_BASE_URL=https://evapp.xingkeele.com/prod-api
EXTERNAL_API_TIMEOUT=30

# ---- 微信公众号 ----
WECHAT_TOKEN=your-wechat-token
