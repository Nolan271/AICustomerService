# AiCustomerService 环境配置 — 阿里云百炼 MaaS
# 复制为 .env 并填入实际值

# ---- 应用 ----
APP_NAME=AiCustomerService
DEBUG=true
SECRET_KEY=change-me-in-production

# ---- LLM（阿里云百炼 MaaS / OpenAI 兼容接口） ----
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-your-api-key-here
OPENAI_BASE_URL=https://your-workspace-id.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
OPENAI_MODEL=qwen3.7-plus

# ---- Embedding（阿里云百炼 DashScope） ----
EMBEDDING_PROVIDER=dashscope
DASHSCOPE_API_KEY=sk-your-api-key-here
DASHSCOPE_BASE_URL=https://your-workspace-id.cn-beijing.maas.aliyuncs.com/api/v1
EMBEDDING_MODEL=text-embedding-v3

# ---- Qdrant ----
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=knowledge_base
QDRANT_VECTOR_SIZE=1024

# ---- 数据库 ----
DATABASE_URL=sqlite+aiosqlite:///./data/sqlite/app.db

# ---- RAG ----
CHUNK_SIZE=500
CHUNK_OVERLAP=50
TOP_K_RETRIEVAL=5
TOP_K_RERANK=3
RETRIEVAL_SCORE_THRESHOLD=0.5

# ---- 对话 ----
MAX_HISTORY_LENGTH=10
STREAMING=true
TEMPERATURE=0.3

# ---- 管理员 ----
ADMIN_API_KEY=admin-secret-key

# ---- 外部充电桩 API（小程序对接平台） ----
EXTERNAL_API_BASE_URL=https://you-xxx/prod-api
EXTERNAL_API_TIMEOUT=30
