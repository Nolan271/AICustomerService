# AiCustomerService 生产环境配置
APP_NAME=AiCustomerService
DEBUG=false
SECRET_KEY=change-me-to-a-strong-random-secret

# LLM
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-your-production-key
OPENAI_BASE_URL=https://your-workspace.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
OPENAI_MODEL=qwen3.7-plus
FAST_LLM_MODEL=qwen-plus

# Embedding
EMBEDDING_PROVIDER=dashscope
DASHSCOPE_API_KEY=sk-your-production-key
DASHSCOPE_BASE_URL=https://your-workspace.cn-beijing.maas.aliyuncs.com/api/v1
EMBEDDING_MODEL=text-embedding-v4

# Qdrant（Docker 内用 service 名）
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_COLLECTION=knowledge_base
QDRANT_VECTOR_SIZE=1024

# 数据库（Docker 内用持久化卷）
DATABASE_URL=sqlite+aiosqlite:///data/sqlite/app.db

# RAG
CHUNK_SIZE=500
CHUNK_OVERLAP=50
TOP_K_RETRIEVAL=5
TOP_K_RERANK=3
RETRIEVAL_SCORE_THRESHOLD=0.5

# 对话
MAX_HISTORY_LENGTH=10
STREAMING=true
TEMPERATURE=0.3

# 管理员
ADMIN_API_KEY=change-me-in-production

# 媒体文件（生产用 Nginx 代理路径）
MEDIA_DIR=./data/media/images
MEDIA_BASE_URL=/media/images

# 外部充电桩 API
EXTERNAL_API_BASE_URL=https://evapp.xingkeele.com/prod-api
EXTERNAL_API_TIMEOUT=30

# 微信
WECHAT_TOKEN=change-me-in-production
